<!--
  06 · WI-FI · ŞİFRE GİRİŞİ

  Tasarimda elle cizilen 40 tusluk klavye, burada LVGL'in hazir lv_keyboard
  widget'ina birakilir: tus haritasi, buyuk/kucuk harf gecisi ve backspace
  davranisi widget'in kendisinden gelir. Tuslar LV_PART_ITEMS uzerinden
  tasarim token'lariyla boyanir.

  Tus renkleri iki gruba ayrilir. LVGL'in tus haritasinda harf olmayan her
  tus (shift, backspace, enter, mod degistirme) LV_BUTTONMATRIX_CTRL_CHECKED
  bayragi tasir; yani kalici olarak "checked" durumdadir. Bu yuzden:
    -items          -> harf tuslari
    -items-checked  -> ozel tuslar
  Ayni mantik pressed icin de gecerli: -items-pressed / -items-checked-pressed.

  Tasarimdan tek sapma: amber "BAĞLAN" tusu klavyenin son satirinda degil,
  parola satirinin sagindadir — cunku lv_keyboard'un kendi tus haritasi vardir.
  Birebir ayni satiri istersen ozel bir keymap gerekir (bkz. NAVIGATION.md).

  Gecisler:
    GERİ / İPTAL -> wifi_list (move_bottom / yukari kaydirma)
    BAĞLAN       -> home_main (fade_in)
-->
<screen name="wifi_password" permanent="true">
	<view
		flex_flow="column"
		style_pad_top="26"
		style_pad_bottom="24"
		style_pad_left="40"
		style_pad_right="40"
		style_pad_row="14"
	>
		<style name="screen_root" />

		<!-- ust bar -->
		<lv_obj
			width="100%"
			height="content"
			flex_flow="row"
			style_flex_main_place="space_between"
			style_flex_cross_place="center"
		>
			<style name="plain" />

			<lv_obj
				name="back"
				width="content"
				height="content"
				flex_flow="row"
				style_flex_cross_place="center"
				style_pad_column="8"
			>
				<style name="plain" />
				<lv_image src="ui_back" style_image_recolor="#text_2" style_image_recolor_opa="255" />
				<lv_label
					text="GERİ"
					style_text_font="mono_13"
					style_text_color="#text_2"
					style_text_letter_space="2"
				/>
				<screen_load_event screen="main_screen" trigger="clicked" anim_type="move_bottom" duration="500" />
			</lv_obj>

			<lv_label
				name="cancel"
				text="İPTAL"
				style_text_font="mono_13"
				style_text_color="#text_3"
				style_text_letter_space="2"
			>
				<screen_load_event screen="main_screen" trigger="clicked" anim_type="move_bottom" duration="500" />
			</lv_label>
		</lv_obj>

		<!-- hangi aga baglaniliyor -->
		<lv_obj width="100%" height="content" flex_flow="row" style_flex_cross_place="center" style_pad_column="14">
			<style name="plain" />

			<lv_obj
				width="40"
				height="40"
				flex_flow="row"
				style_flex_main_place="center"
				style_flex_cross_place="center"
				style_flex_track_place="center"
				style_bg_color="#bg_raised"
				style_bg_opa="255"
				style_radius="11"
				style_border_color="#hairline"
				style_border_opa="20"
				style_border_width="1"
			>
				<lv_image src="ui_lock_lg" style_image_recolor="#accent_warm" style_image_recolor_opa="255" />
			</lv_obj>

			<lv_obj width="content" height="content" flex_flow="column" style_pad_row="4">
				<style name="plain" />
				<lv_label name="ssid" bind_text="wifi_ssid" style_text_font="disp_26" style_text_color="#text_1" />
				<lv_label
					text="AĞA BAĞLANMAK İÇİN ŞİFREYİ GİRİN"
					style_text_font="mono_12"
					style_text_color="#text_3"
					style_text_letter_space="2"
				/>
			</lv_obj>
		</lv_obj>

		<!-- parola alani -->
		<lv_obj width="100%" height="content" flex_flow="column" style_pad_row="8">
			<style name="plain" />
			<lv_label text="PAROLA" style_text_font="mono_12" style_text_color="#text_3" style_text_letter_space="2" />

			<lv_obj width="100%" height="content" flex_flow="row" style_flex_cross_place="center" style_pad_column="12">
				<style name="plain" />

				<lv_textarea
					name="password"
					flex_grow="1"
					height="58"
					one_line="true"
					password_mode="true"
					placeholder_text="Ağ parolası"
					style_text_font="mono_26"
				>
					<style name="field_focus" />
				</lv_textarea>

				<!-- parolayi gor/gizle -->
				<lv_button
					name="reveal"
					width="58"
					height="58"
					style_bg_color="#bg_well"
					style_bg_opa="255"
					style_radius="15"
					style_border_color="#hairline"
					style_border_opa="20"
					style_border_width="1"
				>
					<lv_image src="ui_eye" align="center" style_image_recolor="#text_2" style_image_recolor_opa="255" />
				</lv_button>

				<lv_button name="connect" width="150" height="58">
					<style name="key_accent" />
					<lv_label
						text="BAĞLAN"
						align="center"
						style_text_font="mono_15"
						style_text_color="#bg_base"
						style_text_letter_space="2"
					/>
					<screen_load_event screen="main_screen" trigger="clicked" anim_type="move_bottom" duration="500" />
				</lv_button>
			</lv_obj>
		</lv_obj>

		<!-- ekran klavyesi -->
		<lv_keyboard
			name="keyboard"
			width="100%"
			flex_grow="1"
			mode="text_lower"
			style_bg_color="#bg_base"
			style_bg_opa="255"
			style_pad_all="0"
			style_border_width="0"
			style_pad_row="8"
			style_pad_column="8"
			style_bg_color-items="#bg_raised"
			style_bg_opa-items="255"
			style_radius-items="10"
			style_border_color-items="#hairline"
			style_border_opa-items="20"
			style_border_width-items="1"
			style_text_color-items="#text_2"
			style_bg_color-items-checked="#bg_well"
			style_bg_opa-items-checked="255"
			style_text_color-items-checked="#text_2"
		/>
	</view>
</screen>
