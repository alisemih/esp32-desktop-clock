<!--
  day_chip — alarmin tekrar gunu rozeti (PZT ... PAZ).

  Aktif/pasif ayrimi prop ile stil secilemedigi icin, aktif gunler kullanim
  yerinde yerel stil ile vurgulanir (bkz. alarm_set.xml) — hour_card'daki
  "ŞİMDİ" karti ile ayni yaklasim.
-->
<component>
	<api>
		<prop name="label" type="string" default="" />
		<prop name="label_color" type="color" default="0x5A6672" />
	</api>

	<view
		extends="lv_obj"
		width="42"
		height="42"
		flex_flow="row"
		style_flex_main_place="center"
		style_flex_cross_place="center"
		style_flex_track_place="center"
	>
		<style name="chip" />
		<lv_label name="chip_label" text="$label" style_text_color="$label_color" />
	</view>
</component>
